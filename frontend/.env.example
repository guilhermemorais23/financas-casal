VITE_API_URL=http://localhost:4000/api

# Against the local emulators these can stay as placeholder values -- the
# emulator SDKs don't validate them. Replace with real values from the
# Firebase Console only when pointing at a real project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-par.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-par

# Set to connect the Firebase Auth SDK to the local emulator instead of prod.
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
