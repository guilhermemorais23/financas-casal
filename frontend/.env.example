# Modelo das variáveis do frontend. Copie pra frontend/.env (cp .env.example .env).
# O .env não vai pro Git. Só variáveis que começam com VITE_ chegam no navegador.

# Endereço do backend: todo pedido do app vai pra cá (lido em src/api/client.ts).
# No seu PC é o backend local; em produção o CI troca pelo Render.
VITE_API_URL=http://localhost:4000/api

# Contra o emulador local estes podem ficar com valores de mentira -- o
# emulador não confere. Troque pelos valores reais do Firebase Console só
# quando for apontar pra um projeto de verdade.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-par.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-par

# Preenchido = o login usa o emulador local em vez da produção.
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Opcional: e-mail de contato mostrado em /privacidade (pedidos da LGPD).
VITE_PRIVACY_CONTACT_EMAIL=

# Opcional: quem presta o serviço, mostrado nos Termos de uso (/termos).
# O Código de Defesa do Consumidor pede nome e CPF/CNPJ visíveis pra quem paga.
VITE_LEGAL_NAME=
VITE_LEGAL_DOCUMENT=
