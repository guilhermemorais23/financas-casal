rules_version = '2';

// Todo acesso ao Firestore passa pelo backend Express, pelo Admin SDK, que
// ignora estas regras por completo. O frontend nunca fala direto com o
// Firestore (só com o Firebase Auth, pro login), então o acesso pelo
// navegador é negado de vez.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
