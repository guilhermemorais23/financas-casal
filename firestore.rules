rules_version = '2';

// All Firestore access goes through the Express backend via the Admin SDK,
// which bypasses these rules entirely. The frontend never talks to Firestore
// directly (only to Firebase Auth), so client access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
