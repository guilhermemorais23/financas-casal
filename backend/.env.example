FIREBASE_PROJECT_ID=demo-par
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=4000

# Optional -- welcome email on first sign-in + the daily reminder e-mails
# (see CRON_SECRET below). Without these set, sending is skipped (logged,
# not thrown). Sends via Gmail's own SMTP using a real personal account --
# a stand-in until this project has its own verified domain on a proper
# transactional provider (Resend, etc.); the default Resend sandbox address
# lands in spam almost every time, a real Gmail account does much better.
# GMAIL_APP_PASSWORD is NOT your normal Gmail password -- generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be on first).
# GMAIL_USER=voce@gmail.com
# GMAIL_APP_PASSWORD=

# Optional -- AI assistant (Telegram + the in-app chat widget, POST
# /api/assistant/chat). Without a key, both return 503. Get a key at
# https://aistudio.google.com/apikey.
# GEMINI_API_KEY=

# Optional -- Telegram assistant (log expenses / ask about spending by
# chat). Create a bot with @BotFather to get the token, then register the
# webhook (once, after deploying):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/api/assistant/telegram/webhook&secret_token=<WEBHOOK_SECRET>"
# Without TELEGRAM_BOT_TOKEN, the webhook silently no-ops.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Optional -- WhatsApp assistant (same idea as Telegram above, over
# WhatsApp instead). Needs a Meta for Developers app with the WhatsApp
# product added:
#   1. https://developers.facebook.com/apps -> create app -> add "WhatsApp".
#   2. On the app's WhatsApp > API Setup page: WHATSAPP_PHONE_NUMBER_ID and a
#      temporary WHATSAPP_ACCESS_TOKEN are both shown there (the temporary
#      token expires in ~24h -- fine for testing, swap for a permanent
#      System User token before relying on this for real).
#   3. Testing without business verification: that same page lets you add up
#      to 5 personal "recipient" numbers (OTP-verified) that can message
#      Meta's test number -- that's who ends up talking to this bot.
#   4. WHATSAPP_VERIFY_TOKEN is any string you make up -- register the
#      webhook once, in the app's WhatsApp > Configuration page: callback
#      URL = <BACKEND_URL>/api/assistant/whatsapp/webhook, verify token =
#      the same string, then subscribe to the "messages" field.
# Without WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID, sending silently
# no-ops; without WHATSAPP_VERIFY_TOKEN, the webhook handshake always 403s.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Optional -- admin dashboard (GET /api/admin/overview). Comma-separated
# emails allowed to see it; anyone else gets 403. Without this set, nobody
# has access.
# ADMIN_EMAILS=you@example.com

# Optional -- stock quotes (GET /api/quotes). Free token at
# https://brapi.dev. Without it, the free tier may still work for a couple
# of tickers, but historical ranges usually need one; a 401/403 from brapi
# surfaces as a 503 from this endpoint.
# BRAPI_TOKEN=

# Optional -- daily reminder e-mails (fatura de cartão vencendo, orçamento
# estourado), sent via GMAIL_USER/GMAIL_APP_PASSWORD above. POST /api/reminders/run is
# meant to be called once a day by an external cron (the same cron-job.org
# setup already used to ping /api/health) with this value as the
# x-cron-secret header. Without CRON_SECRET set, the route always 401s --
# pick any random string and set the same value on the cron job.
# CRON_SECRET=
