FIREBASE_PROJECT_ID=demo-par
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PORT=4000

# Optional -- welcome email on first sign-in. Without a key, sending is
# skipped (logged, not thrown). Get a key at https://resend.com.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=PAR. <onboarding@resend.dev>

# Optional -- AI spending analysis (GET /api/insights). Without a key, the
# endpoint returns 503. Get a key at https://aistudio.google.com/apikey.
# GEMINI_API_KEY=

# Optional -- Telegram assistant (log expenses / ask about spending by
# chat). Create a bot with @BotFather to get the token, then register the
# webhook (once, after deploying):
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BACKEND_URL>/api/assistant/telegram/webhook&secret_token=<WEBHOOK_SECRET>"
# Without TELEGRAM_BOT_TOKEN, the webhook silently no-ops.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Optional -- admin dashboard (GET /api/admin/overview). Comma-separated
# emails allowed to see it; anyone else gets 403. Without this set, nobody
# has access.
# ADMIN_EMAILS=you@example.com
